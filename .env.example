# =====================================================================
# Banco de dados
# =====================================================================
# Postgres local (docker compose up -d):
DATABASE_URL=postgresql://acervo:acervo@localhost:5432/acervo

# Supabase — use a "Connection string" do painel (Session pooler, porta 5432).
# Troque [SENHA] pela senha do banco e mantenha sslmode=require.
# DATABASE_URL=postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres?sslmode=require

# Onde ficam os PDFs/DOCX anexados ao acervo.
STORAGE_DIR=./storage

# =====================================================================
# Ingestão
# =====================================================================
# Protege POST /api/ingerir. Sem esta variável, a rota só aceita
# chamadas de localhost. Defina antes de expor a aplicação na rede.
# INGESTAO_TOKEN=troque-por-um-segredo-longo

# Endereço da própria aplicação, usado pelo CLI de ingestão.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# DJEN — Diário de Justiça Eletrônico Nacional (comunicações)
# ---------------------------------------------------------------------
# A consulta por OAB é pública. Só preencha o token se o escritório
# tiver acesso autenticado ao serviço de comunicações do PJe.
# DJEN_API_URL=https://comunicaapi.pje.jus.br/api/v1
# DJEN_API_TOKEN=

# ---------------------------------------------------------------------
# DataJud — API Pública do CNJ (metadados e movimentos)
# ---------------------------------------------------------------------
# A chave é pública e divulgada pelo CNJ na wiki do DataJud. Ela muda de
# tempos em tempos, por isso fica aqui e não no código.
# DATAJUD_API_KEY=
# DATAJUD_API_URL=https://api-publica.datajud.cnj.jus.br

# ---------------------------------------------------------------------
# PDPJ — DataLake (documentos: inicial, sentença, LAUDO)
# ---------------------------------------------------------------------
# Só preencha se o escritório tiver credencial própria de acesso ao
# DataLake. Sem isso, use a importação por arquivo:
#   npm run ingerir -- pdpj --arquivo documentos.json
# PDPJ_API_URL=
# PDPJ_API_TOKEN=

# =====================================================================
# Autenticação e deploy
# =====================================================================
# Em produção, NODE_ENV=production faz o cookie de sessão exigir HTTPS.
# A Vercel já define isso sozinha.
