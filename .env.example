# Conexão com o banco.
#
# Postgres local (docker compose up -d):
DATABASE_URL=postgresql://acervo:acervo@localhost:5432/acervo

# Supabase — use a "Connection string" do painel (Session pooler, porta 5432).
# Troque [SENHA] pela senha do banco e mantenha sslmode=require.
# DATABASE_URL=postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres?sslmode=require

# Onde ficam os PDFs/DOCX anexados ao acervo.
STORAGE_DIR=./storage
